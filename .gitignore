# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Secrets — the real API key lives in .env; keep the .env.example template tracked
.env
!.env.example

# Steam-bot PoC: stored login_key / sentry (unattended re-login credentials)
.steambot_creds/
# Steam agent: the saved refresh token IS a login credential, and its node deps
steambot/agent/.steam-refresh-token
steambot/agent/node_modules/

# Editors / OS
.idea/
.vscode/
.DS_Store

# Keep the demos/ folder but ignore the (large) demo files themselves
demos/*
!demos/.gitkeep

# Generated HTML reports
output/

# Web app runtime data: SQLite DB (+WAL/SHM) and streamed upload temp files
web/data/
!web/data/.gitkeep

# Claude Code harness state (not project source)
.claude/

# Rust / WASM build artifacts
rust/target/
rust/viewer/pkg/
rust/viewer/www/pkg/
rust/viewer/www/assets/
# Dev-page test artifacts copied next to rust/viewer/www/index.html for local runs
rust/viewer/www/manifest.json
rust/viewer/www/*.3dr
# dev mirror of web/static/replay3d/sfx.js (the canonical copy is the tracked one)
rust/viewer/www/sfx.js

# 3D replay build outputs. The wasm bundle and the radar PNG copies are
# regenerated by tools/build_replay3d.ps1, so they stay ignored. Converted map
# geometry under assets/maps/ IS tracked (large *.glb -> Git LFS, see .gitattributes).
web/static/replay3d/pkg/
web/static/replay3d/assets/*.png
web/static/replay3d/assets/*.jpg

# Real CS2 character models: built from a local CS2 install by
# tools/convert_characters.ps1 and never committed (the repo is public). Without
# them, or with REPLAY3D_CS2_MODELS=0, the viewer falls back to models/player.glb.
web/static/replay3d/assets/models/cs2_v1/
rust/viewer/www/assets/models/cs2_v1/
# The same goes for what the other convert_*.ps1 scripts take from CS2: sounds,
# HUD icons and textured maps. The page falls back to its own synth, text labels
# and the plain map without them.
web/static/replay3d/assets/sounds_v1/
web/static/replay3d/assets/hud_v1/
web/static/replay3d/assets/maps_v2/

# Precompressed static siblings (regenerated by tools/precompress.py; served
# by web/app.py's CompressedStaticFiles — never commit them)
web/static/replay3d/**/*.br
web/static/replay3d/**/*.gz

# External reference project (a friend's private repo — knowledge source only,
# never commit: `git add -A` would otherwise embed it as a gitlink)
CS2MapViewer-master/
CS2MapViewer/

# Source2Viewer-CLI download used by tools/prepare_map.py docs
tools/s2v/
# Raw Source2Viewer map exports (hundreds of MB, regenerated from the .vpk;
# only the prepared world.glb under web/static/replay3d/assets/maps/ is kept)
raw/

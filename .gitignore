# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Secrets — the real API key lives in .env; keep the .env.example template tracked
.env
!.env.example

# Steam-bot PoC: stored login_key / sentry (unattended re-login credentials)
.steambot_creds/

# Editors / OS
.idea/
.vscode/
.DS_Store

# Keep the demos/ folder but ignore the (large) demo files themselves
demos/*
!demos/.gitkeep

# Generated HTML reports
output/

# Web app runtime data: SQLite DB (+WAL/SHM) and streamed upload temp files
web/data/
!web/data/.gitkeep

# Claude Code harness state (not project source)
.claude/

# Rust / WASM build artifacts
rust/target/
rust/viewer/pkg/
rust/viewer/www/pkg/
rust/viewer/www/assets/

# 3D replay build outputs: wasm bundle, radar copies, converted map assets (large, generated)
web/static/replay3d/pkg/
web/static/replay3d/assets/

# External reference project (a friend's private repo — knowledge source only,
# never commit: `git add -A` would otherwise embed it as a gitlink)
CS2MapViewer-master/
CS2MapViewer/

# Source2Viewer-CLI download used by tools/prepare_map.py docs
tools/s2v/

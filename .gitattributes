# Normalize line endings in the index to LF (there was no .gitattributes before,
# so this makes normalization explicit). This general rule comes FIRST so the
# specific binary / LFS rules below override it (later match wins per-attribute).
* text=auto

# Binary formats: never apply EOL conversion.
*.png binary
*.jpg binary
*.wasm binary
*.dem binary
*.3dr binary
*.bin binary

# Converted CS2 map geometry is large binary -> Git LFS. `-text` keeps the real
# bytes untouched (must win over `* text=auto` above -> this line comes later).
# A fresh clone needs `git lfs install` once and `git lfs pull` to fetch the real
# bytes (without LFS you get small text pointer files, not usable .glb meshes).
*.glb filter=lfs diff=lfs merge=lfs -text
*.gltf filter=lfs diff=lfs merge=lfs -text

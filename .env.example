# Copy this file to .env and fill it in. Read via python-dotenv; no key is ever
# hardcoded in source.

# ---- Coaching reports ----
# The coach runs FREE by default: `local` is a rule engine over the measured
# tactical fact sheet (demoreview/coachrules.py). No account, no API, no
# per-report cost, ~2 s per report. It needs the match's 3D artifacts.
#
# `api` swaps in the LLM coach (src/coach.py). It reads the same facts but is
# better at fusing several metrics into one root cause -- and every report is a
# paid Anthropic call (~$0.11 on Opus 5, ~$0.04 on Sonnet 5). Opt in on purpose.
COACH_BACKEND=local
# Only used when COACH_BACKEND=api:
#COACH_MODEL=claude-sonnet-5
#ANTHROPIC_API_KEY=sk-ant-...
# Report language: ru (default) or en. The free rule engine is Russian-only.
#COACH_LANGUAGE=ru

# ---- Web app (web/) ----
# REQUIRED: signs session cookies. Use a long random string, e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=MEOWWWWWWWWWWWWWWWWWWWWWWWWWWWWW

# Public base URL the browser uses to reach the app; builds the Steam OpenID
# return_to/realm. Use the host's LAN IP (e.g. http://192.168.1.20:8000) so
# friends on the network can log in. Must match where the app is actually served.
BASE_URL=http://localhost:8000

# OPTIONAL: Steam Web API key -> real display names + avatars.
# Get one free at https://steamcommunity.com/dev/apikey
# If unset, users are shown by their SteamID64 (login still works).
STEAM_API_KEY=

# OPTIONAL overrides (sensible defaults if omitted)
# APP_DB_PATH=web/data/app.db
# MAX_UPLOAD_MB=800
# PARSE_CONCURRENCY=1
# HOST=0.0.0.0
# PORT=8000
# 0 discards each demo after parsing. By default a gzipped copy (about 70% of the
# demo's size) stays in web/data/demos/, so a newer extractor can re-run on it.
# KEEP_DEMOS=1

# ============================================================================
# Steam-bot proof-of-concept (steambot/) -- auto match detection + demo download
# See steambot/README.md for exactly where to get each value. All optional
# unless you actually run `python -m steambot`.
# ============================================================================

# --- The BOT Steam account (a throwaway; NOT your personal account) ---
# It logs into the CS2 Game Coordinator. It must have the free CS2 license
# (the tool requests it automatically). It does NOT need to be your friend.
STEAMBOT_USERNAME=
STEAMBOT_PASSWORD=
# OPTIONAL: base64 shared_secret from the bot's mobile authenticator, for fully
# automatic 2FA codes. If empty, run `python -m steambot login` once by hand.
STEAMBOT_SHARED_SECRET=

# --- Multi-user auto-import (the web app + steambot/worker.py) ---
# Every player subscribes on /connect (their auth code + sharecode go to the DB),
# so nothing per-player is needed here. STEAM_API_KEY (above) is REQUIRED: without
# it the sharecode chain cannot run and /connect refuses to save.
#
# The bot's public profile -- /connect links players at it so THEY send the friend
# invite (the bot only ever accepts, never invites: outgoing bot invites are a
# spam-flag trigger). Leave empty to hide the Steam-chat half of the page.
STEAMBOT_PROFILE_URL=
STEAMBOT_PERSONA=demoReview bot
# Shared secret between worker and Node agent (any random string). The agent binds
# to loopback; this stops OTHER local processes from driving the bot.
STEAMBOT_AGENT_TOKEN=
# STEAMBOT_AGENT_URL=http://127.0.0.1:8790
# STEAMBOT_AGENT_PORT=8790
# How often each subscription is polled, and how many are swept at once.
# STEAMBOT_POLL_INTERVAL_S=300
# STEAMBOT_BATCH=25

# --- Single-account PoC only (steambot/poc.py, `python -m steambot`) ---
# The multi-user path above does not read these.
STEAMBOT_TARGET_STEAMID=
# Your Match History Authentication Code (format AAAA-AAAAA-AAAA). This is NOT
# your password -- generate it at:
#   https://help.steampowered.com/en/wizard/HelpWithGameIssue/?appid=730&issueid=128
# That same page also shows your most recent sharecode -- use it as the seed below.
STEAMBOT_MATCH_AUTH_CODE=
# A recent sharecode (CSGO-xxxxx-...) to start walking from. Must be <= ~1 month
# old. From the help page above, or CS2 > Watch > Your Matches (copy share link).
STEAMBOT_KNOWN_SHARECODE=
# STEAMBOT_DOWNLOAD_DIR=demos/auto

# --- 3D replay (optional; see docs/REPLAY3D.md) ---
# Path to the extract3d release binary. When missing, uploads still work --
# matches just have no 3D replay. Default: rust/target/release/extract3d(.exe)
# EXTRACT3D_BIN=
# Kill a hung extraction after this many seconds.
# EXTRACT3D_TIMEOUT_S=900
# 0 shows the plain fallback soldier in the 3D replay instead of the real CS2 player
# models (tools/convert_characters.ps1 builds those from a local CS2 install; without
# them the soldier is used anyway).
# REPLAY3D_CS2_MODELS=1

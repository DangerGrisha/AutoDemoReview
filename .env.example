# Copy this file to .env and fill in your key. .env is read by src/coach.py
# (Layer 6) via python-dotenv; the key is never hardcoded in source.
ANTHROPIC_API_KEY=sk-ant-...

# ---- Web app (web/) ----
# REQUIRED: signs session cookies. Use a long random string, e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=MEOWWWWWWWWWWWWWWWWWWWWWWWWWWWWW

# Public base URL the browser uses to reach the app; builds the Steam OpenID
# return_to/realm. Use the host's LAN IP (e.g. http://192.168.1.20:8000) so
# friends on the network can log in. Must match where the app is actually served.
BASE_URL=http://localhost:8000

# OPTIONAL: Steam Web API key -> real display names + avatars.
# Get one free at https://steamcommunity.com/dev/apikey
# If unset, users are shown by their SteamID64 (login still works).
STEAM_API_KEY=

# OPTIONAL overrides (sensible defaults if omitted)
# APP_DB_PATH=web/data/app.db
# MAX_UPLOAD_MB=800
# PARSE_CONCURRENCY=1
# HOST=0.0.0.0
# PORT=8000

# ============================================================================
# Steam-bot proof-of-concept (steambot/) -- auto match detection + demo download
# See steambot/README.md for exactly where to get each value. All optional
# unless you actually run `python -m steambot`.
# ============================================================================

# --- The BOT Steam account (a throwaway; NOT your personal account) ---
# It logs into the CS2 Game Coordinator. It must have the free CS2 license
# (the tool requests it automatically). It does NOT need to be your friend.
STEAMBOT_USERNAME=
STEAMBOT_PASSWORD=
# OPTIONAL: base64 shared_secret from the bot's mobile authenticator, for fully
# automatic 2FA codes. If empty, run `python -m steambot login` once by hand.
STEAMBOT_SHARED_SECRET=

# --- The TARGET player (you) whose matches we watch ---
# STEAM_API_KEY (above) is reused as the Web API key for the sharecode chain.
# Your SteamID64 (17 digits). Find it at steamid.io or in your profile URL.
STEAMBOT_TARGET_STEAMID=
# Your Match History Authentication Code (format AAAA-AAAAA-AAAA). This is NOT
# your password -- generate it at:
#   https://help.steampowered.com/en/wizard/HelpWithGameIssue/?appid=730&issueid=128
# That same page also shows your most recent sharecode -- use it as the seed below.
STEAMBOT_MATCH_AUTH_CODE=
# A recent sharecode (CSGO-xxxxx-...) to start walking from. Must be <= ~1 month
# old. From the help page above, or CS2 > Watch > Your Matches (copy share link).
STEAMBOT_KNOWN_SHARECODE=

# OPTIONAL behaviour overrides
# STEAMBOT_POLL_INTERVAL_S=90
# STEAMBOT_DOWNLOAD_DIR=demos/auto
